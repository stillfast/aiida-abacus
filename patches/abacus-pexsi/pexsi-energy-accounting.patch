 #include "module_elecstate/module_dm/cal_dm_psi.h"
@@ -107,8 +108,21 @@ void HSolverLCAO<T, Device>::solve(hamilt::Hamilt<T>* pHamilt,
             // solve eigenvector and eigenvalue for H(k)
             pe.diag(pHamilt, psi, nullptr);
         }
+        // PEXSI fills these three scalars only on the ranks that drive the pole expansion; every
+        // other rank would keep eband = 0 and therefore report a different total energy (with
+        // `out_alllog 1`: rank0 E_band = 79.2661 eV, ranks1-3 E_band = 0). Publish them first.
+#ifdef __MPI
+        Parallel_Common::bcast_double(pe.totalEnergyH);
+        Parallel_Common::bcast_double(pe.totalEnergyS);
+        Parallel_Common::bcast_double(pe.totalFreeEnergy);
+#endif
         auto _pes = dynamic_cast<elecstate::ElecStateLCAO<T>*>(pes);
-        pes->f_en.eband = pe.totalFreeEnergy;
+        // totalEnergyH = Tr[H*DM] is the band energy (what sum_i f_i eps_i means for the exact DM),
+        // while totalFreeEnergy = Tr[H*DM] - T*S additionally carries the electronic entropy, which
+        // ABACUS keeps in its own term f_en.demet. Assigning the free energy to eband counted the
+        // entropy into the band term and left demet = 0.
+        pes->f_en.eband = pe.totalEnergyH;
+        pes->f_en.demet = pe.totalFreeEnergy - pe.totalEnergyH;
         // maybe eferm could be dealt with in the future
         _pes->dmToRho(pe.DM, pe.EDM);
 #endif
